<?xml version="1.0" encoding="utf-8"?>
<!--
   T07: allowBackup đã tắt trong manifest. Khai báo exclusion bổ sung cho thiết bị
   cũ (API < 31) để không backup database chứa CCCD/tọa độ nếu OEM vẫn cho phép.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>