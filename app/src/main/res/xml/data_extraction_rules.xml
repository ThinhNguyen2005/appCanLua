<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room contains values encrypted by a device-bound Android Keystore key. -->
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>