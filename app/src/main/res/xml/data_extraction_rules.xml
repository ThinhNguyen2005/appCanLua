<?xml version="1.0" encoding="utf-8"?>
<!--
   T07: Loại database nhạy cảm (CCCD, tọa độ, ledger) khỏi cả cloud-backup lẫn
   device-transfer. Backup chủ động của người dùng đi qua JSON portable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>