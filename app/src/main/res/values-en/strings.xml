    <string name="weight_metrics_bag_info_title">⚖️ Tare Weight</string>
    <string name="weight_metrics_bag_info_description">The average weight of the empty rice bags (typically around 0.5kg - 1.2kg depending on the bag type). The total tare weight (Tare × Bag Count) will be directly deducted from the total gross weight.</string>
    <string name="weight_metrics_impurity_info_title">🍂 Impurity Deduction</string>
    <string name="weight_metrics_impurity_info_description">The weight of impurities (straw, soil, sand, empty grains) present in the rice lot, mutually agreed to be deducted by a fixed kg amount to ensure fairness for clean rice buyers.</string>
    <string name="weight_metrics_moisture_info_title">💧 Moisture Deduction</string>
    <string name="weight_metrics_moisture_info_description">The actual rice moisture measured at the field. The commercial standard moisture is 14%. If the moisture is higher, a drying shrinkage percentage will be deducted from the actual weight based on mutual agreement.</string>
    <string name="weight_metrics_formula_info_content">View calculation formula</string>
    <string name="weight_metrics_formula_info_title">📐 Payment formula</string>
    <string name="weight_metrics_formula_info_description">1) Net weight = (Total kg − Bag × Bag count − Impurity) × (100 − Moisture) ÷ (100 − 14).\n\n2) Total amount = Net weight × Price per kg.\n\nExample: 1,000 kg, bag 1kg × 20 bags = 20kg, impurity 5kg, moisture 18% → Net ≈ (1000 − 20 − 5) × (100 − 18) ÷ 86 ≈ 929.7 kg. Price 8,500đ/kg → Total ≈ 7.9 million.</string>
    <string name="weight_metrics_impurity_label_percent">Impurity (%)</string>

