    <string name="create_card_impurity_help_title">Trừ Tạp Chất</string>
    <string name="create_card_impurity_help_description">Số ký (kg) tạp chất (rơm, rạ, đất...) sẽ tự động trừ trực tiếp vào tổng khối lượng lúa của phiếu này khi tính toán khối lượng thực tế.</string>
