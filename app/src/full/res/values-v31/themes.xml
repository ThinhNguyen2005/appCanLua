<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+ (API 31) native Splash Screen overrides.
        The system uses android: namespace attributes directly.
        compat library Theme.SplashScreen forwards these on API 31+,
        but explicit declaration ensures OEM skins honor our config.
    -->
    <style name="Theme.CanLua.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2E7D32</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.CanLua</item>

        <!-- Android 12+ platform attributes -->
        <item name="android:windowSplashScreenBackground">#2E7D32</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>

</resources>
