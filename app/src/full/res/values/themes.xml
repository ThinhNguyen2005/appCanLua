<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CanLua" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Theme dành riêng cho MainActivity trong khoảng thời gian khởi động.
        postSplashScreenTheme = Theme.CanLua để sau khi splash exit, cửa sổ
        Activity trở về theme gốc (Compose tự quản lý màu nền sau đó).
    -->
    <style name="Theme.CanLua.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#2E7D32</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.CanLua</item>
    </style>

</resources>
