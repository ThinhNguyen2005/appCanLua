## local.properties configuration example
#
# Copy this file as 'local.properties' in the root directory and fill in the keys below.
# DO NOT commit local.properties to git — it contains secrets.

# Android SDK path (auto-set by Android Studio or enter manually)
sdk.dir=YOUR_ANDROID_SDK_DIR_PATH

# Google Maps API Key (for purchase map)
MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE

# Google Apps Script Handshake Token
APP_HANDSHAKE_TOKEN=YOUR_APP_HANDSHAKE_TOKEN_HERE

# Telegram (notifications & feedback bots)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID_HERE

# OpenRouter (AI chat — Gemini Flash via openrouter.ai)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Supabase — rice_prices + news_articles storage
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
